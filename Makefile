# cluster-api-provider-zkvm Makefile
#
# Usage:
#   make generate        — regenerate zz_generated.deepcopy.go
#   make manifests       — regenerate CRD YAML files under config/crd/bases/
#   make build           — compile the controller binary locally (CGo, s390x host required)
#   make docker-build    — build the container image (run 'make build' first)
#   make docker-push     — push the container image to the registry
#   make release         — generate infrastructure-components.yaml for clusterctl
#   make deploy          — apply CRDs + controller into the current cluster (kubectl context)
#   make undeploy        — remove everything deployed by "make deploy"
#   make test            — run unit tests

# Image name and tag — override with: IMG=myregistry/myimage:tag make docker-build
IMG ?= quay.io/rh-ee-dveerabh/cluster-api-provider-zkvm:v0.1.0

# controller-gen version to use for CRD/deepcopy generation.
CONTROLLER_GEN_VERSION ?= v0.17.3

# Directories.
LOCALBIN    ?= $(shell pwd)/bin
CONTROLLER_GEN ?= $(LOCALBIN)/controller-gen

# Go settings.
GOARCH  ?= s390x
GOOS    ?= linux

.PHONY: all
all: generate manifests build

# ── Code generation ───────────────────────────────────────────────────────────

.PHONY: generate
generate: controller-gen
	## Regenerate zz_generated.deepcopy.go for all API types.
	$(CONTROLLER_GEN) object:headerFile="hack/boilerplate.go.txt" paths="./api/..."

.PHONY: manifests
manifests: controller-gen
	## Regenerate CRD YAML files and RBAC marker annotations.
	$(CONTROLLER_GEN) \
		crd \
		rbac:roleName=cluster-api-provider-zkvm-manager-role \
		webhook \
		paths="./..." \
		output:crd:artifacts:config=config/crd/bases \
		output:rbac:artifacts:config=config/rbac

# ── Build ─────────────────────────────────────────────────────────────────────

.PHONY: build
build:
	## Build the controller binary for s390x.
	CGO_ENABLED=1 GOOS=$(GOOS) GOARCH=$(GOARCH) go build -o bin/manager ./main.go

# ── Docker / Podman ───────────────────────────────────────────────────────────

.PHONY: docker-build
docker-build: build
	## Build the controller container image (requires bin/manager built by 'make build').
	podman build -t $(IMG) .

.PHONY: docker-push
docker-push:
	## Push the controller container image to the registry.
	podman push $(IMG)

# ── Release ───────────────────────────────────────────────────────────────────

# RELEASE_DIR is where infrastructure-components.yaml is written.
RELEASE_DIR ?= $(shell pwd)/out

.PHONY: release
release: manifests
	## Generate infrastructure-components.yaml for clusterctl provider installation.
	## This file is uploaded to the GitHub release as a release asset.
	##
	## Steps:
	##   1. Runs 'make manifests' to ensure CRD YAMLs are up to date.
	##   2. Uses kustomize to render config/default/ into a single YAML.
	##   3. Writes the result to out/infrastructure-components.yaml.
	##
	## After running this target:
	##   - Commit any CRD changes generated by make manifests
	##   - Create a GitHub release (e.g. v0.1.0)
	##   - Upload out/infrastructure-components.yaml as a release asset
	##   - The asset URL becomes the clusterctl provider URL
	mkdir -p $(RELEASE_DIR)
	cd config/manager && kustomize edit set image cluster-api-provider-zkvm=$(IMG)
	kustomize build config/default > $(RELEASE_DIR)/infrastructure-components.yaml
	@echo ""
	@echo "✅ infrastructure-components.yaml written to $(RELEASE_DIR)/infrastructure-components.yaml"
	@echo ""
	@echo "Next steps:"
	@echo "  1. git add config/ && git commit -m 'chore: regenerate CRDs for release'"
	@echo "  2. git tag v0.1.0 && git push origin v0.1.0"
	@echo "  3. Create GitHub release v0.1.0"
	@echo "  4. Upload $(RELEASE_DIR)/infrastructure-components.yaml as release asset"
	@echo "  5. Release URL: https://github.ibm.com/Srinivas-Alubilli/cluster-api-provider-zkvm/releases/download/v0.1.0/infrastructure-components.yaml"

# ── Deploy / undeploy ─────────────────────────────────────────────────────────

.PHONY: deploy
deploy: manifests
	## Apply CRDs + RBAC + controller Deployment into the current kubectl context.
	cd config/manager && kustomize edit set image cluster-api-provider-zkvm=$(IMG)
	kubectl apply -k config/default

.PHONY: undeploy
undeploy:
	## Remove everything deployed by "make deploy".
	kubectl delete -k config/default --ignore-not-found

# ── Tests ─────────────────────────────────────────────────────────────────────

.PHONY: test
test:
	## Run unit tests.
	go test ./... -v

# ── Tools ─────────────────────────────────────────────────────────────────────

.PHONY: controller-gen
controller-gen: $(CONTROLLER_GEN)
$(CONTROLLER_GEN): $(LOCALBIN)
	## Download controller-gen if not present.
	test -s $(CONTROLLER_GEN) || \
	GOBIN=$(LOCALBIN) go install sigs.k8s.io/controller-tools/cmd/controller-gen@$(CONTROLLER_GEN_VERSION)

$(LOCALBIN):
	mkdir -p $(LOCALBIN)
